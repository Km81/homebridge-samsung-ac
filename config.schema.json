{
  "pluginAlias": "SamsungAC",
  "pluginType": "platform",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "에어컨 이름",
        "type": "string",
        "required": true,
        "description": "홈 앱에 표시될 에어컨의 이름을 입력하세요."
      },
      "ip": {
        "title": "에어컨 IP 주소",
        "type": "string",
        "format": "ipv4",
        "required": true
      },
      "token": {
        "title": "인증 토큰",
        "type": "string",
        "required": true
      },
      "deviceIndex": {
        "title": "장치 인덱스 (읽기)",
        "type": "integer",
        "default": 0
      },
      "setDeviceIndex": {
        "title": "장치 인덱스 (쓰기)",
        "type": "integer"
      },
      "swingModeType": {
        "title": "스윙(회전) 모드 타입",
        "type": "string",
        "default": "comfort",
        "oneOf": [
            { "title": "컴포트 모드 (바람세기 자동 조절)", "enum": ["comfort"] },
            { "title": "상하 회전 (바람 방향만 조절)", "enum": ["wind"] }
        ]
      },
      "pollingInterval": {
        "title": "상태 폴링 간격 (초)",
        "type": "integer"
      },
      "timeout": {
        "title": "요청 시간 초과 (ms)",
        "type": "integer",
        "default": 5000
      },
      "cacheDuration": {
        "title": "캐시 유지 시간 (ms)",
        "type": "integer",
        "default": 30000
      },
      "certPath": {
        "title": "인증서 경로 (선택 사항)",
        "type": "string",
        "description": "플러그인 내장 인증서 대신 사용할 pem 파일의 전체 경로를 입력하세요."
      },
      "keyPath": {
        "title": "키 파일 경로 (선택 사항)",
        "type": "string",
        "description": "인증서와 다른 키 파일을 사용할 경우, pem 파일의 전체 경로를 입력하세요."
      },
      "debug": {
        "title": "상세 로그 활성화",
        "type": "boolean",
        "default": false
      },
      "minTemp": {
        "title": "최저 설정 온도 (°C)",
        "type": "integer",
        "default": 18
      },
      "maxTemp": {
        "title": "최고 설정 온도 (°C)",
        "type": "integer",
        "default": 30
      },
      "manufacturer": {
        "title": "제조사",
        "type": "string",
        "default": "Samsung"
      },
      "model": {
        "title": "모델명",
        "type": "string",
        "default": "AC-Model"
      },
      "serialNumber": {
        "title": "시리얼 번호",
        "type": "string"
      }
    }
  }
}
