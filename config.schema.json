{
  "pluginAlias": "SamsungACPlatform",
  "pluginType": "platform",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "플랫폼 이름",
        "type": "string",
        "default": "삼성 에어컨",
        "required": true
      },
      "accessories": {
        "type": "array",
        "title": "에어컨 장치 목록",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "액세서리 이름",
              "type": "string",
              "required": true,
              "description": "홈 앱에 표시될 에어컨의 이름을 입력하세요."
            },
            "ip": {
              "title": "에어컨 IP 주소",
              "type": "string",
              "format": "ipv4",
              "required": true
            },
            "token": {
              "title": "인증 토큰",
              "type": "string",
              "required": true
            },
            "deviceIndex": {
              "title": "장치 인덱스 (읽기)",
              "type": "integer",
              "default": 0
            },
            "setDeviceIndex": {
              "title": "장치 인덱스 (쓰기)",
              "type": "integer"
            },
            "swingModeType": {
              "title": "스윙(회전) 모드 타입",
              "type": "string",
              "default": "comfort",
              "oneOf": [
                { "title": "컴포트 모드 (바람세기 자동 조절)", "enum": ["comfort"] },
                { "title": "상하 회전 (바람 방향만 조절)", "enum": ["wind"] }
              ]
            },
            "pollingInterval": {
              "title": "상태 폴링 간격 (초)",
              "type": "integer"
            },
            "timeout": {
              "title": "요청 시간 초과 (ms)",
              "type": "integer",
              "default": 5000
            },
            "cacheDuration": {
              "title": "캐시 유지 시간 (ms)",
              "type": "integer",
              "default": 30000
            },
            "debug": {
              "title": "상세 로그 활성화",
              "type": "boolean",
              "default": false
            },
            "minTemp": {
              "title": "최저 설정 온도 (°C)",
              "type": "integer",
              "default": 18
            },
            "maxTemp": {
              "title": "최고 설정 온도 (°C)",
              "type": "integer",
              "default": 30
            },
            "manufacturer": {
              "title": "제조사",
              "type": "string",
              "default": "Samsung"
            },
            "model": {
              "title": "모델명",
              "type": "string",
              "default": "AC-Model"
            },
            "serialNumber": {
              "title": "시리얼 번호",
              "type": "string",
              "default": "A1-SERIAL"
            }
          }
        }
      }
    }
  },
  "layout": [
    {
      "type": "help",
      "help": "이 플러그인은 TLSv1을 사용하는 구형 삼성 에어컨을 위한 것입니다. 각 에어컨 장치를 아래 목록에 추가하여 관리할 수 있습니다."
    },
    "name",
    {
      "key": "accessories",
      "type": "list",
      "title": "에어컨 목록",
      "buttonText": "에어컨 추가",
      "items": [
        "name",
        "ip",
        {
          "key": "token",
          "type": "password"
        },
        {
          "type": "fieldset",
          "title": "고급 설정",
          "expandable": true,
          "items": [
            "deviceIndex",
            "setDeviceIndex",
            "swingModeType",
            "pollingInterval",
            "timeout",
            "cacheDuration"
          ]
        },
        {
            "type": "fieldset",
            "title": "부가 기능 설정",
            "expandable": true,
            "items": [
              "debug",
              "minTemp",
              "maxTemp"
            ]
        },
        {
          "type": "fieldset",
          "title": "액세서리 정보 (선택 사항)",
          "expandable": true,
          "items": [
            "manufacturer",
            "model",
            "serialNumber"
          ]
        }
      ]
    }
  ]
}
